{
  "framework": "vite",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/id", "destination": "/id/index.html" },
    { "source": "/wallpaperlive", "destination": "/wallpaperlive/index.html" },
    { "source": "/wallpaperlive/id", "destination": "/wallpaperlive/id/index.html" },
    { "source": "/transparentbar", "destination": "/transparentbar/index.html" },
    { "source": "/transparentbar/id", "destination": "/transparentbar/id/index.html" },
    { "source": "/doc", "destination": "/doc/index.html" },
    { "source": "/doc/id", "destination": "/doc/id/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-9jFo/ySn5JVAa9g2NIRdLz8aZ0tBWrAun0OG5dIWKnw='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://raw.githubusercontent.com data:; media-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
